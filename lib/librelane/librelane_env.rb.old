    # end

    def process_blif_input(blif_path)
      blif = Pathname(blif_path)
      @circ_name = blif.basename.to_s.split('.').first
      dest = @layout.blif(blif.basename)
      FileUtils.cp(blif, dest)
      @env.merge!('BLIF_NAME' => blif.basename.to_s, 'BLIF_PATH' => dest.to_s, 'CIRC_NAME' => @circ_name)
      BlifRenamer.new.rename(dest.to_s) unless Pathname("#{dest}.bak").exist?
    end

    def gen_ateta_stim(circ_name, inserted_std_cell: nil, fun: :max)
      path = nil
      @circ_name = circ_name
      Dir.chdir("#{@pwd}/librelane_env") do
        init_circ = Verilog.load_netlist(get_pnr_v)
        SDF.annotate(init_circ, get_pnr_sdf, fun: fun)
        ht_dly = init_circ.get_comp_min_delay(@dly_mdl)

        generator = AtetaAddOn::AtetaLibrelane.new(
          self,
          init_circ,
          ht_dly,
          @dly_mdl,
          inserted_std_cell: inserted_std_cell
        )
        generator.generate_stim
        path = generator.save_explicit("made/#{@circ_name}/#{@circ_name}.stim", binStimVec: true)
        path = File.expand_path(path)
      end
      path
    end

    def gen_htpg_transport_dly_stim(inserted_std_cell: nil, risky_signals: [])
      Dir.chdir("#{@pwd}/librelane_env") do
        init_circ = Verilog.load_netlist(get_pnr_v)
        init_dly_db = SDF.generate_dly_db(init_circ, get_pnr_sdf)
        ht_dly = init_circ.get_comp_min_delay(:sdf, dly_db: init_dly_db)

        generator = AtetaAddOn::HtpgLibrelane.new(
          self,
          init_circ,
          ht_dly,
          init_dly_db,
          smt_format: :pure,
          inserted_std_cell: inserted_std_cell,
          risky_signals: risky_signals
        )
        generator.generate_stim
        generator.save_explicit("made/#{@circ_name}/#{@circ_name}.stim", binStimVec: true)
      end
    end

    def gen_htpg_rec_stim(inserted_std_cell: nil, risky_signals: [])
      Dir.chdir("#{@pwd}/librelane_env") do
        init_circ = Verilog.load_netlist(get_pnr_v)
        init_dly_db = SDF.generate_dly_db(init_circ, get_pnr_sdf)
        ht_dly = init_circ.get_comp_min_delay(:sdf, dly_db: init_dly_db)

        generator = AtetaAddOn::HtpgLibrelane.new(
          self,
          init_circ,
          ht_dly,
          init_dly_db,
          smt_format: :rec,
          inserted_std_cell: inserted_std_cell,
          risky_signals: risky_signals
        )
        generator.generate_stim
        generator.save_explicit("made/#{@circ_name}/#{@circ_name}.stim", binStimVec: true)
      end
    end

    def insert_buf_and_finalize(attacked_sig, inserted_std_cell = "#{@lblane_config.scl_target}__buf_8")
      puts ' > Attack place and route'

      inserted_std_cell = "#{@lblane_config.scl_target}__buf_8" if inserted_std_cell.nil?

      # Dir.chdir('librelane_env') do
      last_run_path = last_run_path
      pp last_run_path # !DEBUG
      last_drt_path = Dir["#{last_run_path}/*detailedrouting*"].last

      if last_drt_path.nil?
        raise 'No detailed routing step found in last run directory, previous run was not a pnr run or it was not fully completed'
      end

      @env['ATTACKED_SIG'] = attacked_sig
      @env['INSERTED_STD_CELL'] = inserted_std_cell

      template_path = File.expand_path("#{@pwd}/librelane_env/librelane/template_insert_config.json")
      config_path = File.expand_path("#{@pwd}/librelane_env/librelane/insert_config.json")
      cmd = "envsubst < #{template_path} > #{config_path}"
      system(@env, cmd)

      STDOUT.sync = true
      IO.popen(
        "nix-shell #{@LBLANE_NIX} --run \"librelane #{config_path} --with-initial-state #{last_drt_path}/state_out.json --from Odb.InsertECOBuffers\"", 'r+'
      ) do |f|
        puts f.gets until f.eof?
      end

      raise 'Insertion failed, check and modify PnR configuration if required then try again' unless last_run_success?

      attacked_sig_name = attacked_sig.tr('/', '_')
      save_last_run_files("#{@circ_name}_apnr_#{attacked_sig_name}")
    end

    def get_pnr_v
      "made/#{@circ_name}/#{@circ_name}_pnr.v"
    end

    def get_pnr_sdf
      "made/#{@circ_name}/#{@circ_name}_pnr.sdf"
    end

    def last_run_path
      run = @layout.runs_dir.children.select(&:directory?).max_by(&:mtime)
      raise "Aucun run trouvé dans #{@layout.runs_dir}" unless run

      run
    end

    # def get_last_run_path
