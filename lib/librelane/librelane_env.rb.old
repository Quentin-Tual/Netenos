    def compare2_sim(cfg)
      sim_dir = Pathname(cfg.activity_log_path).dirname.tap(&:mkpath)
      opt = cfg.full_traces ? ['-voptargs=+acc'] : []

      run!('vlib', 'sky130', chdir: sim_dir)
      %w[primitives_fixed.v].each { run!('vlog', '-work', 'sky130', @pdk.scl_verilog / it, chdir: sim_dir) }
      %w[sky130_ef_io_fixed.v sky130_fd_io_fixed.v].each do
        run!('vlog', '-work', 'sky130', @pdk.io_verilog / it, chdir: sim_dir)
      end
      run!('vlib', 'work', chdir: sim_dir)
      run!('vlog', cfg.ref_v, chdir: sim_dir)
      run!('vlog', cfg.ut_v, chdir: sim_dir)
      run!('vlog', '-sv', cfg.tb_path, chdir: sim_dir)
      run!('vsim', *opt, '-c', '-L', 'sky130', '+transport_int_delays',
           '-sdftyp', "pnr_dut=#{cfg.ref_sdf}", '-sdftyp', "a_pnr_dut=#{cfg.ut_sdf}",
           "tb_#{cfg.circ_name}", '-sdfnoerror', '+sdf_report_unannotated_insts',
           '-do', 'run -all', chdir: sim_dir)
    end

    def analyze_logs(circ_name, stim_path, nb_outputs, activity_log_path)
      Dir.chdir(File.dirname(activity_log_path)) do
        log = ActivityLog::Log.new('activity.log')
        detector = ActivityLog::LogDetector.new(log, stim_path, nb_outputs)
        detector.generate_gnuplot_data
        detector.generate_filtered_gnuplot_data

        File.rename('activity.log', 'activity_pnr1Xapnr.log')
        File.rename('activity.log.data', 'activity_pnr1Xapnr.log.data')
        File.rename('activity.log_filtered.data', 'activity_pnr1Xapnr.log_filtered.data')
        File.rename("tb_#{circ_name}.vcd", "tb_#{circ_name}_pnr1Xapnr.vcd")
      end
    end

    def sim_only(pnr_path, apnr_path, stim_path, period: 10)
      pnr_nl = Verilog.load_netlist("#{pnr_path}.v")
      apnr_nl = Verilog.load_netlist("#{apnr_path}.v")
      tb_path = "tb/tb_#{pnr_nl.name}.v"
      circ_name = pnr_nl.name

      tb_generator = Converter::GenPnrCompTestbench.new(pnr_nl, apnr_nl)
      tb_generator.gen_testbench(circ_name, stim_path, period, path: tb_path, full_traces: true)

      run_sim(circ_name, pnr_path, pnr_path, apnr_path, tb_path, full_traces: true)
      `mv activity.log #{apnr_path}/activity.log`
      `mv tb_#{circ_name}.vcd #{apnr_path}/tb_#{circ_name}.vcd`

      analyze_logs(circ_name, stim_path, pnr_nl.nb_outputs, "#{apnr_path}/activity.log")
    end

    # Replaces sim_only for the comparison simulation of 2 circuits
    def simulate(sim_config)
      Converter.gen_pnr_comp_testbench(sim_config)

      compare2_sim(sim_config)
      `mv activity.log #{sim_config.activity_log_path}`
      `mv tb_#{sim_config.circ_name}.vcd #{sim_config.vcd_path}`

      analyze_logs(sim_config.circ_name, sim_config.stim_path, sim_config.ref_nl.get_nb_outputs,
                   sim_config.activity_log_path)
    end

    def sim_all_apnr(circ_name = @circ_name, stim_path: "made/#{circ_name}/#{circ_name}.stim", period: 100)
      # Check if pwd is a dir named "librelane_env" if not chdir in it, raise if an error occurs

      altered_circuits = Dir["made/#{circ_name}/apnr_*.v"].collect { |path| path.delete_suffix('.v') }

      pnr_nl = "made/#{circ_name}/#{circ_name}_pnr"
      stim_path = File.expand_path(stim_path)

      raise "File #{stim_path} does not exist." unless File.exist?(stim_path)

      altered_circuits.each do |apnr|
        Dir.mkdir(apnr) unless Dir.exist?(apnr)
        sim_only(pnr_nl, apnr, stim_path, period)
      end
    end

    def sim_all_apnr2(sim_config)
      Dir.chdir("#{@pwd}/librelane_env") do
        altered_circuits = Dir["made/#{@circ_name}/#{@circ_name}_apnr_*.v"].collect do |path|
          path.delete_suffix('.v')
        end

        if altered_circuits.empty?
          raise "No altered circuits found matching made/#{@circ_name}/#{sim_config.circ_name}_apnr_*.v from pwd : #{Dir.pwd}"
        end

        # pnr = "made/#{circ_name}/#{circ_name}_pnr"
        # sim_config.ref_v = "#{pnr}.v"
        # sim_config.ref_sdf = "#{pnr}.sdf"

        # sim_config.stim_path = File.expand_path(stim_path)

        # raise "File #{stim_path} does not exist." unless File.exist?(stim_path)

        altered_circuits.each do |apnr|
          Dir.mkdir(apnr) unless Dir.exist?(apnr)

          ut_nl = Verilog.load_netlist("#{apnr}.v")
          ut_pnr_files = PnrFiles.new(ut_nl, "#{apnr}.v", "#{apnr}.sdf")
          sim_outputs = SimOutputs.new("#{apnr}/activity.log", "#{apnr}/tb_#{sim_config.circ_name}.vcd")

          sim_config = sim_config.add_ut_pnr_files(ut_pnr_files)
          sim_config = sim_config.add_sim_outputs(sim_outputs)

          # sim_config.ut_v = "#{apnr}.v"
          # sim_config.ut_sdf = "#{apnr}.sdf"
          simulate(sim_config)
        end
      end
    end

    private

    def check_install
      @LBLANE_NIX = `find $HOME -wholename "*librelane/shell.nix" -print -quit`.delete_suffix("\n")
      if @LBLANE_NIX.empty?
        raise 'No Nix based LibreLane installation found, please see : https://librelane.readthedocs.io/en/stable/installation/index.html'
      end

      sky130_v = (eval `nix-shell #{@LBLANE_NIX} --run "ciel ls --pdk sky130"`).last
      @PDK = `nix-shell #{@LBLANE_NIX} --run "ciel path --pdk sky130 #{sky130_v}"`
      if @PDK.empty?
        raise 'No Skywater 130nm PDK found with Ciel from Nix based LibreLane installation, please see : https://librelane.readthedocs.io/en/stable/installation/index.html'
      end

      @PDK_V_FILES = "#{@PDK}/sky130A/libs.ref/sky130_fd_io/verilog"
      @PDK_V_FILES2 = "#{@PDK}/sky130A/libs.ref/#{@lblane_config.scl_target}/verilog"

      if `which yosys-abc`.empty?
        raise 'No Yosys ABC found, please see : https://github.com/YosysHQ/oss-cad-suite-build'
      end

      res = `vsim -version`
      raise "Check Questasim installation, command 'vsim' returned : #{res}" if res.include?('not found')

      fix_pdk
    end

    def fix_pdk_files(p)
      files2fix = `ls #{p}`.split("\n")
      files2fix.each do |f|
        system("sed 's/`default_nettype none/`default_nettype wire/g' #{p}/#{f} > #{p}/#{f.delete_suffix('.v')}_fixed.v")
      end
    end

    def fix_pdk
      paths = ["#{@PDK}/sky130A/libs.ref/sky130_fd_io/verilog",
               "#{@PDK}/sky130A/libs.ref/#{@lblane_config.scl_target}/verilog"]

      paths.each do |p|
        if `ls #{p} | grep "_fixed.v"`.empty?
          puts "> INFO : Fixing PDK Verilog files in #{p}"
          fix_pdk_files p
        else
          puts '> INFO : PDK Verilog files already fixed'
          return 0
        end
      end
    end

    def check_dirs
      # Deploy template_env
      return if Dir.exist?("#{@pwd}/librelane_env")

      template_dir_path = "#{File.dirname(__FILE__)}/template_env.tar"
      Minitar.unpack(template_dir_path, @pwd)
      FileUtils.mv("#{@pwd}/template_env", "#{@pwd}/librelane_env")
    end

    def last_run_success?
      last_run_path = last_run_path
      error_log_file = "#{last_run_path}/error.log"
      File.empty?(error_log_file)
    end

    def pnr
      puts ' > Place and route'

      FP_CORE_UTIL_VALUES.each do |val|
        @env['FP_CORE_UTIL'] = @fp_core_util = val.to_s

        cmd = 'envsubst < librelane/template_config.json > librelane/config.json'
        system(@env, cmd)

        run_pnr

        return nil if last_run_success?

        # FileUtils.rm_r(last_run_path)
      end

      raise "No valid configuration found to place and route the circuit #{@circ_name}"
    end

    def run_pnr
      STDOUT.sync = true
      IO.popen("nix-shell #{@LBLANE_NIX} --run \"librelane librelane/config.json\"", 'r+') do |f|
        puts f.gets until f.eof?
      end
    end

