    def save_last_run_files(name)
      run = last_run_path
      nls = run.glob('final/nl/*.nl.v')
      raise "Exactement 1 netlist attendue, trouvé #{nls.size}" unless nls.size == 1

      circ = nls.first.basename('.nl.v').to_s
      sdf  = run.glob('final/sdf/nom_tt_025C_1v80/*__nom_tt_025C_1v80.sdf').first or
        raise "SDF introuvable dans #{run}"

      out = @layout.made_dir(circ).tap(&:mkpath)
      v_out = out / "#{name}.v"
      sdf_out = out / "#{name}.sdf"
      FileUtils.cp(nls.first, v_out)
      FileUtils.cp(sdf, sdf_out)
      rename_altered_module(name, v_out, sdf_out)

      Librelane::PnrFiles.new(Verilog.load_netlist(v_out.to_s), v_out.to_s, sdf_out.to_s)
    end

    def rename_altered_module(new_name, v_path, sdf_path)
      `sed -i --regexp-extended 's/module \\w+/module #{new_name}/' #{v_path}`
      `sed -i --regexp-extended -e 's/DESIGN ".+"/DESIGN "#{new_name}"/' -e 's/CELLTYPE ".*#{@circ_name}"/CELLTYPE "#{new_name}"/' #{sdf_path}`
    end
  end
end
