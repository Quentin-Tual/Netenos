# frozen_string_literal: true

require 'English'
require 'find'
module Librelane
  class LibrelaneEnv
    FP_CORE_UTIL_VALUES = [1, 5, 10, 20, 50].freeze

    def initialize(lblane_config, pwd = '.')
      @layout = Layout.new(pwd) # pwd absolu dès la construction
      @pdk    = Pdk.new(pdk_root, lblane_config.scl_target)

      @pwd = pwd
      @dly_mdl = :sdf
      @lblane_config = lblane_config

      @fp_core_util = FP_CORE_UTIL_VALUES.first
      # @fp_core_util_idx = 0

      # Check if librelane is accessible through nix
      # if yes fetch all paths required (pdk, librelane .nix file)
      check_install
      # Check if required directories are existing, else create them
      check_dirs

      excluded_cells = "[#{lblane_config.excluded_cells.collect { |name| "\"#{name}\"" }.join(",\n")}]"
      @env = {
        'LB_LANE' => (@LB_LANE = File.expand_path("#{@pwd}/librelane_env/librelane/runs")),
        'PDK' => @PDK,
        'FP_CORE_UTIL' => @fp_core_util.to_s,
        'SCL_TARGET' => @lblane_config.scl_target,
        'PERIOD' => @lblane_config.period.to_s,
        'EXTRA_EXCLUDED_CELLS' => excluded_cells
      }
    end

    def run!(*cmd, chdir: nil, env: @env, **redir)
      opts = redir
      opts[:chdir] = chdir.to_s if chdir
      system(env, *cmd.map(&:to_s), **opts) or
        raise "Commande échouée (#{$CHILD_STATUS&.exitstatus}) : #{cmd.join(' ')}"
    end

    # def synth
    #   puts ' > BLIF to Verilog conversion'

    #   cmd = 'envsubst < synth/template_synth.abc > synth/synth.abc'
    #   system(@env, cmd)
    #   `yosys-abc -f synth/synth.abc`
    # end

    def synth
      puts ' > BLIF to Verilog conversion'
      run!('envsubst', in: @layout.synth_template.to_s, out: @layout.synth_script.to_s)
      run!('yosys-abc', '-f', @layout.synth_script, chdir: @layout.env_dir)
    end

    def synth_only(blif_path)
      Dir.chdir("#{@pwd}/librelane_env") do
        process_blif_input(blif_path)
        synth
      end
    end

    def synth_n_pnr(blif_path)
      Dir.chdir("#{@pwd}/librelane_env") do
        process_blif_input(blif_path)
        synth
        pnr
        save_last_run_files("#{@circ_name}_pnr")
        # @v_pnr = "made/#{@circ_name}/#{@circ_name}_pnr.v"
        # @sdf_pnr = "made/#{@circ_name}/#{@circ_name}_pnr.sdf"
      end
    end

